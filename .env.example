# Copy this file to ".env" and fill in your real values.
#   Windows:        copy .env.example .env
#   macOS / Linux:  cp .env.example .env

# Your API key. Direct Anthropic keys start with "sk-ant-".
# If you route through a proxy (e.g. AgentRouter), paste that provider's key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Leave BLANK to talk to Anthropic directly.
# To use an Anthropic-compatible proxy, set the BARE domain here — the SDK
# appends /v1/messages itself, so do NOT include a /v1 suffix.
#   Example: https://your-proxy.example.com
ANTHROPIC_BASE_URL=
